# =====================================================================
# staging.tfvars — PLANTILLA. Copia a `staging.tfvars` REAL y rellena.
# =====================================================================
# Este archivo va en .gitignore — NUNCA commitearlo con valores reales.
#
# Cómo obtener cada valor:
#   tenancy_ocid: OCI Console → Profile (avatar arriba) → Tenancy
#   user_ocid:    OCI Console → Profile → My profile
#   fingerprint:  Después de crear API key en User Settings → API Keys
#   compartment_ocid: Identity → Compartments → tu compartment
# =====================================================================

tenancy_ocid     = "ocid1.tenancy.oc1..REPLACE_ME"
user_ocid        = "ocid1.user.oc1..REPLACE_ME"
fingerprint      = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
private_key_path = "~/.oci/oci_api_key.pem"
region           = "us-ashburn-1"
compartment_ocid = "ocid1.compartment.oc1..REPLACE_ME"

environment = "staging"

# Networking
vcn_cidr = "10.0.0.0/16"

# OKE
oke_kubernetes_version = "v1.30.1"
oke_node_pool_size     = 3
oke_node_shape         = "VM.Standard.E4.Flex"
oke_node_ocpus         = 2
oke_node_memory_gb     = 16

# PostgreSQL
postgres_shape           = "VM.Standard.E4.Flex"
postgres_ocpus           = 2
postgres_memory_gb       = 16
postgres_instance_count  = 3
# Generar con: openssl rand -base64 24
postgres_admin_password  = "REPLACE_WITH_STRONG_PASSWORD"

# Redis
redis_node_memory_gb = 8
