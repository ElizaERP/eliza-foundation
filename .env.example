# =====================================================================
# ELIZA Foundation Platform — Environment Variables
# =====================================================================
# Copy this file to .env for local development.
# In production, these values come from secret managers (Vault / AWS SM).

# ---------- Application ----------
NODE_ENV=development
APP_NAME=eliza-foundation
APP_PORT=3000
APP_GLOBAL_PREFIX=api
APP_VERSION=v1
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ---------- PostgreSQL ----------
# ⚠️ DATABASE_URL DEBE usar app_user — NUNCA postgres.
#    Un superusuario se salta la Row Level Security: con postgres aquí,
#    el aislamiento entre tenants queda APAGADO aunque las policies existan.
#    Verifícalo con: make db-rls-check
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/eliza?schema=public

# Conexión privilegiada SOLO para migraciones y seeds (no la usa la app).
# Local: el Makefile ya usa el superusuario de docker-compose por defecto
# (make db-migrate / db-seed / seed-catalog / seed-inventory).
# Sin make:  DATABASE_URL="<esta url>" pnpm prisma migrate dev
# Endurecer a un migration_user dedicado es tarea de la Fase 3 (Seguridad).
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5432/eliza?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=eliza:

# ---------- Keycloak ----------
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=eliza
KEYCLOAK_CLIENT_ID=eliza-api
KEYCLOAK_CLIENT_SECRET=replace-me-in-production
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/eliza/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://localhost:8080/realms/eliza
KEYCLOAK_AUDIENCE=eliza-api
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ---------- JWT ----------
JWT_ALGORITHM=RS256
JWT_CACHE_MAX_AGE_MS=600000

# ---------- Tenant Resolution ----------
# Strategy: jwt | subdomain | header (priority order, comma-separated)
TENANT_RESOLUTION_STRATEGY=jwt,header
TENANT_HEADER_NAME=X-Tenant-Id
TENANT_REQUIRE_ACTIVE=true

# ---------- Observability ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=eliza-foundation
METRICS_ENABLED=true
TRACING_ENABLED=true

# ---------- Security ----------
HELMET_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ---------- Outbox Dispatcher (Sprint 4) ----------
# El dispatcher es el worker que publica los eventos al bus.
# Para tener pods "writers-only" en k8s, poner ENABLED=false en ellos.
OUTBOX_DISPATCHER_ENABLED=true
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_MAX_RETRIES=5
OUTBOX_RETRY_BACKOFF_BASE_MS=1000
OUTBOX_STUCK_LEASE_MS=60000
OUTBOX_RECLAIM_INTERVAL_MS=30000

# ---------- Event Bus (Sprint 4) ----------
# in_memory: dev y single-pod
# redis_streams: producción multi-pod
EVENT_BUS_TYPE=in_memory
EVENT_BUS_STREAM_PREFIX=eliza:event:
EVENT_BUS_CONSUMER_GROUP=eliza-foundation
