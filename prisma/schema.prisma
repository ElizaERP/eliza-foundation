// =====================================================================
// ELIZA Foundation Platform — Prisma Schema
// =====================================================================
// Schema base del Modular Monolith. Cada bounded context (Tenant, IAM,
// Audit) añadirá sus modelos durante los Sprints 1, 2 y 3.
//
// Convenciones obligatorias para TODO modelo de ELIZA:
//   1. PK = String @id @default(uuid()) con tipo UUID v7 (ulid en runtime)
//   2. Todo modelo de negocio incluye tenantId String NOT NULL (excepto
//      el propio modelo Tenant, que ES el tenant)
//   3. Auditoría obligatoria: createdAt, createdBy, updatedAt, updatedBy
//   4. Soft delete opcional: deletedAt, deletedBy
//   5. Optimistic concurrency: version Int NOT NULL @default(1)
//   6. snake_case en BD vía @map; PascalCase en TypeScript
//   7. RLS habilitado en todas las tablas con tenantId (ver migration init)
// =====================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  schemas    = ["tenant", "iam", "audit", "platform", "catalog", "inventory", "manufacturing", "sales"]
  extensions = [pgcrypto, uuid_ossp(map: "uuid-ossp")]
}

// =====================================================================
// TENANT CONTEXT — Sprint 1 (esqueleto mínimo para Sprint 0)
// =====================================================================

enum TenantStatus {
  PendingActivation
  Active
  Suspended
  Deleted

  @@schema("tenant")
}

enum TenantPlan {
  Basic
  Professional
  Enterprise

  @@schema("tenant")
}

model Tenant {
  id        String       @id @db.Uuid
  code      String       @unique @db.VarChar(50)
  name      String       @db.VarChar(200)
  status    TenantStatus @default(PendingActivation)
  plan      TenantPlan   @default(Basic)

  // Auditoría
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  createdBy String    @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  updatedBy String    @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  deletedBy String?   @map("deleted_by") @db.Uuid
  version   Int       @default(1)

  @@index([status])
  @@index([code])
  @@map("tenants")
  @@schema("tenant")
}

// =====================================================================
// IAM CONTEXT — Sprint 2 (esqueleto mínimo)
// =====================================================================

enum UserStatus {
  Pending
  Active
  Suspended
  Deleted

  @@schema("iam")
}

model User {
  id             String     @id @db.Uuid
  // El usuario tiene un keycloak subject ID que es la identidad federada
  keycloakSubject String    @unique @map("keycloak_subject") @db.Uuid
  email          String     @unique @db.VarChar(320)
  fullName       String     @map("full_name") @db.VarChar(200)
  status         UserStatus @default(Pending)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  createdBy String    @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  updatedBy String    @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  deletedBy String?   @map("deleted_by") @db.Uuid
  version   Int       @default(1)

  memberships UserTenantMembership[]

  @@map("users")
  @@schema("iam")
}

model UserTenantMembership {
  id       String  @id @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  isActive Boolean @default(true) @map("is_active")
  // Roles asignados a esta membership (espejo de los client roles de Keycloak)
  rolesJson Json   @default("[]") @map("roles_json") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  updatedBy String   @map("updated_by") @db.Uuid
  version   Int      @default(1)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("user_tenant_memberships")
  @@schema("iam")
}

// =====================================================================
// AUDIT CONTEXT — Sprint 3 (esqueleto mínimo, append-only)
// =====================================================================

model AuditLog {
  // UUID v7 (ordenable temporalmente) — generado por aplicación con ulid()
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  // Posición dentro del hash chain del tenant. Monotónica creciente.
  // Asegurado por advisory lock + SELECT MAX + INSERT en transacción.
  chainIndex BigInt   @map("chain_index") @db.BigInt
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz()

  // Quién
  userId    String? @map("user_id") @db.Uuid
  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent") @db.VarChar(500)

  // Qué
  action     String @db.VarChar(100)
  entityType String @map("entity_type") @db.VarChar(100)
  entityId   String? @map("entity_id") @db.Uuid

  // Cambios (JSONB para flexibilidad sin perder queryability)
  oldValues Json? @map("old_values") @db.JsonB
  newValues Json? @map("new_values") @db.JsonB

  // Correlación
  correlationId String? @map("correlation_id") @db.Uuid
  causationId   String? @map("causation_id") @db.Uuid

  // Cadena de hash para inmutabilidad
  previousHash String? @map("previous_hash") @db.Char(64)
  hash         String  @map("hash") @db.Char(64)

  @@unique([tenantId, chainIndex], map: "uniq_audit_chain")
  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, userId, occurredAt(sort: Desc)])
  @@index([tenantId, correlationId])
  @@map("audit_logs")
  @@schema("audit")
}

// =====================================================================
// PLATFORM — Outbox Pattern (compartido por todos los BCs)
// =====================================================================

enum OutboxStatus {
  Pending
  Processing
  Published
  Failed
  DeadLetter

  @@schema("platform")
}

model OutboxEvent {
  id            String       @id @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  aggregateType String       @map("aggregate_type") @db.VarChar(100)
  aggregateId   String       @map("aggregate_id") @db.Uuid
  eventType     String       @map("event_type") @db.VarChar(150)
  eventVersion  Int          @default(1) @map("event_version")
  payload       Json         @db.JsonB
  metadata      Json         @db.JsonB
  status        OutboxStatus @default(Pending)
  occurredAt    DateTime     @default(now()) @map("occurred_at") @db.Timestamptz()

  // Scheduling for retry-after-backoff
  nextRetryAt   DateTime? @map("next_retry_at") @db.Timestamptz()

  // Processing lease — para detectar eventos colgados por dispatcher caído
  processingStartedAt DateTime? @map("processing_started_at") @db.Timestamptz()
  processingNode      String?   @map("processing_node") @db.VarChar(100)

  // Resolución
  publishedAt   DateTime? @map("published_at") @db.Timestamptz()
  retryCount    Int       @default(0) @map("retry_count")
  lastError     String?   @map("last_error") @db.Text

  @@index([status, nextRetryAt])
  @@index([status, occurredAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@map("outbox_events")
  @@schema("platform")
}

// =====================================================================
// Read Models (Sprint 4)
// =====================================================================

model TenantSummary {
  tenantId         String   @id @map("tenant_id") @db.Uuid
  code             String   @db.VarChar(50)
  name             String   @db.VarChar(200)
  status           String   @db.VarChar(50)
  plan             String   @db.VarChar(50)
  userCount        Int      @default(0) @map("user_count")
  activeUserCount  Int      @default(0) @map("active_user_count")
  lastEventAt      DateTime @default(now()) @map("last_event_at") @db.Timestamptz()
  lastEventType    String   @default("") @map("last_event_type") @db.VarChar(150)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([status])
  @@map("tenant_summary")
  @@schema("platform")
}

model ProjectionCheckpoint {
  projectionName       String    @id @map("projection_name") @db.VarChar(100)
  lastProcessedEventId String?   @map("last_processed_event_id") @db.Uuid
  lastProcessedAt      DateTime? @map("last_processed_at") @db.Timestamptz()
  eventsProcessed      BigInt    @default(0) @map("events_processed")
  lastErrorAt          DateTime? @map("last_error_at") @db.Timestamptz()
  lastError            String?   @map("last_error") @db.Text

  @@map("projection_checkpoints")
  @@schema("platform")
}

/// Idempotencia de proyecciones: un registro por (proyección, evento) procesado.
/// Se inserta en la MISMA transacción que actualiza el read model; si ya
/// existe, el evento se ignora (entrega at-least-once sin doble efecto).
model ProcessedEvent {
  projectionName String   @map("projection_name") @db.VarChar(100)
  eventId        String   @map("event_id") @db.Uuid
  processedAt    DateTime @default(now()) @map("processed_at") @db.Timestamptz()

  @@id([projectionName, eventId])
  @@map("processed_events")
  @@schema("platform")
}

// =====================================================================
// Catalog (Sprint 5) — productos, categorías, unidades, BOM
// =====================================================================
// Multi-tenant: TODAS las tablas tienen tenantId + RLS.
// Excepto unit_of_measure_catalog que es CROSS-TENANT (Platform-managed
// catalog of valid units).

enum ProductType {
  RawMaterial
  SemiFinished
  FinishedGood
  Service

  @@schema("catalog")
}

enum ProductStatus {
  Draft
  Active
  Discontinued

  @@schema("catalog")
}

enum UomDimension {
  Mass
  Volume
  Length
  Count
  Time
  Temperature

  @@schema("catalog")
}

// ---------- Catálogo platform-wide de unidades ----------
model UnitOfMeasure {
  id          String       @id @db.Uuid
  code        String       @unique @db.VarChar(20)
  name        String       @db.VarChar(100)
  symbol      String       @db.VarChar(10)
  dimension   UomDimension
  // Factor de conversión a la unidad base de la dimensión (ej. g, ml).
  // 1 kg = 1000 g  → kg.toBaseFactor = 1000
  // 1 g  = 1 g     → g.toBaseFactor  = 1
  toBaseFactor Decimal     @default(1) @map("to_base_factor") @db.Decimal(18, 6)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([dimension, isActive])
  @@map("unit_of_measure")
  @@schema("catalog")
}

// ---------- Categorías (árbol por tenant) ----------
model Category {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  parentId    String?  @map("parent_id") @db.Uuid
  // Path materializado para queries jerárquicas: "/congelados/arepas/mini"
  path        String   @default("") @map("path") @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@unique([tenantId, code], map: "uniq_category_code_per_tenant")
  @@index([tenantId, parentId])
  @@index([tenantId, path])
  @@map("categories")
  @@schema("catalog")
}

// ---------- Productos (aggregate root) ----------
model Product {
  id          String        @id @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  code        String        @db.VarChar(50)
  sku         String        @db.VarChar(50)
  barcode     String?       @db.VarChar(50)
  name        String        @db.VarChar(200)
  description String?       @db.Text
  type        ProductType
  status      ProductStatus @default(Draft)

  categoryId      String  @map("category_id") @db.Uuid
  unitOfSaleId    String  @map("unit_of_sale_id") @db.Uuid

  // Atributos físicos importantes en alimentos congelados
  packSize          Int?     @map("pack_size")              // ej. 12 (12 unidades por paquete)
  netWeightGrams    Decimal? @map("net_weight_grams") @db.Decimal(12, 3)
  grossWeightGrams  Decimal? @map("gross_weight_grams") @db.Decimal(12, 3)
  expiryDays        Int?     @map("expiry_days")            // vida útil tras producción
  storageTempMinC   Decimal? @map("storage_temp_min_c") @db.Decimal(5, 2)  // ej. -18
  storageTempMaxC   Decimal? @map("storage_temp_max_c") @db.Decimal(5, 2)  // ej. -15

  // Metadata
  imageUrl     String?  @map("image_url") @db.VarChar(500)
  taxRate      Decimal? @map("tax_rate") @db.Decimal(5, 2)   // ej. 19.00 (IVA Colombia)
  isControlled Boolean  @default(false) @map("is_controlled") // requiere control especial (lote, cadena fría)

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  category    Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  components  BOMComponent[] @relation("ProductComponents")
  usedInBoms  BOMComponent[] @relation("ComponentUsedIn")

  @@unique([tenantId, code], map: "uniq_product_code_per_tenant")
  @@unique([tenantId, sku], map: "uniq_product_sku_per_tenant")
  @@index([tenantId, status, type])
  @@index([tenantId, categoryId])
  @@index([tenantId, barcode])
  @@map("products")
  @@schema("catalog")
}

// ---------- Bill of Materials ----------
// Relación M:N entre productos: un producto "compuesto" tiene N componentes.
model BOMComponent {
  id           String  @id @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  productId    String  @map("product_id") @db.Uuid       // El producto compuesto
  componentId  String  @map("component_id") @db.Uuid     // El producto que se usa como componente
  quantity     Decimal @db.Decimal(18, 6)                // Cantidad por unidad del producto
  uomId        String  @map("uom_id") @db.Uuid           // En esta unidad de medida
  position     Int     @default(0)                        // Para ordenar la lista en UI
  notes        String? @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  product   Product @relation("ProductComponents",  fields: [productId],   references: [id], onDelete: Cascade)
  component Product @relation("ComponentUsedIn",    fields: [componentId], references: [id], onDelete: Restrict)

  @@unique([tenantId, productId, componentId], map: "uniq_bom_component")
  @@index([tenantId, componentId])
  @@map("bom_components")
  @@schema("catalog")
}

// =====================================================================
// Inventory (Sprint 6) — Lotes, Existencias, FEFO, Kardex
// =====================================================================

enum EstadoLote {
  Disponible
  Bloqueado
  Cuarentena
  Vencido

  @@schema("inventory")
}

enum OrigenLote {
  Production
  Purchase
  Manual

  @@schema("inventory")
}

enum EstadoReserva {
  Active
  Released
  Fulfilled

  @@schema("inventory")
}

enum TipoMovimiento {
  Entrada
  Salida
  TransferenciaSalida
  TransferenciaEntrada
  Ajuste
  Reserva
  LiberacionReserva

  @@schema("inventory")
}

enum TipoUbicacion {
  Camara
  Estante
  Recepcion
  Despacho
  Cuarentena
  Devoluciones

  @@schema("inventory")
}

model Warehouse {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   @db.VarChar(30)
  name      String   @db.VarChar(200)
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  locations Location[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
  @@schema("inventory")
}

model Location {
  id            String        @id @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  warehouseId   String        @map("warehouse_id") @db.Uuid
  code          String        @db.VarChar(30)
  name          String        @db.VarChar(200)
  tipoUbicacion TipoUbicacion @map("tipo_ubicacion")
  tempMinC      Float?        @map("temp_min_c")
  tempMaxC      Float?        @map("temp_max_c")
  capacidadMax  Float?        @map("capacidad_max")
  isActive      Boolean       @default(true) @map("is_active")
  version       Int           @default(1)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  existencias Existencia[]

  @@unique([warehouseId, code])
  @@index([tenantId])
  @@index([warehouseId])
  @@map("locations")
  @@schema("inventory")
}

model Lote {
  id              String     @id @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  codigoLote      String     @map("codigo_lote") @db.VarChar(50)
  productId       String     @map("product_id") @db.Uuid
  fechaProduccion DateTime   @map("fecha_produccion") @db.Date
  fechaVencimiento DateTime  @map("fecha_vencimiento") @db.Date
  cantidadInicial Decimal    @map("cantidad_inicial") @db.Decimal(18, 6)
  estado          EstadoLote @default(Disponible)
  origenTipo      OrigenLote @map("origen_tipo")
  origenRef       String?    @map("origen_ref")
  bloqueadoMotivo String?    @map("bloqueado_motivo")
  bloqueadoPor    String?    @map("bloqueado_por") @db.Uuid
  bloqueadoEn     DateTime?  @map("bloqueado_en") @db.Timestamptz
  notas           String?
  version         Int        @default(1)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  existencias Existencia[]

  @@unique([tenantId, productId, codigoLote])
  @@index([tenantId, productId])
  @@index([fechaVencimiento])
  @@index([estado])
  @@map("lotes")
  @@schema("inventory")
}

model Existencia {
  id                 String   @id @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  loteId             String   @map("lote_id") @db.Uuid
  locationId         String   @map("location_id") @db.Uuid
  cantidadDisponible Decimal  @map("cantidad_disponible") @db.Decimal(18, 6)
  cantidadReservada  Decimal  @map("cantidad_reservada") @db.Decimal(18, 6)
  cantidadBloqueada  Decimal  @map("cantidad_bloqueada") @db.Decimal(18, 6)
  version            Int      @default(1)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  lote     Lote      @relation(fields: [loteId], references: [id])
  location Location  @relation(fields: [locationId], references: [id])
  reservas Reserva[]

  @@unique([tenantId, productId, loteId, locationId])
  @@index([tenantId, productId])
  @@index([loteId])
  @@index([locationId])
  @@map("existencias")
  @@schema("inventory")
}

model Reserva {
  id              String        @id @db.Uuid
  existenciaId    String        @map("existencia_id") @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  referenciaTipo  String        @map("referencia_tipo") @db.VarChar(30)
  referenciaId    String        @map("referencia_id") @db.VarChar(100)
  cantidad        Decimal       @db.Decimal(18, 6)
  estado          EstadoReserva @default(Active)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  releasedAt      DateTime?     @map("released_at") @db.Timestamptz
  releasedReason  String?       @map("released_reason")

  existencia Existencia @relation(fields: [existenciaId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([existenciaId])
  @@index([referenciaTipo, referenciaId])
  @@map("reservas")
  @@schema("inventory")
}

model MovimientoInventario {
  id                String         @id @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  tipo              TipoMovimiento
  productId         String         @map("product_id") @db.Uuid
  loteId            String?        @map("lote_id") @db.Uuid
  locationId        String         @map("location_id") @db.Uuid
  locationDestinoId String?        @map("location_destino_id") @db.Uuid
  cantidad          Decimal        @db.Decimal(18, 6)
  referenciaTipo    String         @map("referencia_tipo") @db.VarChar(30)
  referenciaId      String         @map("referencia_id") @db.VarChar(100)
  motivo            String?
  ocurridoEn        DateTime       @map("ocurrido_en") @db.Timestamptz
  registradoPor     String         @map("registrado_por") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, productId, ocurridoEn])
  @@index([loteId])
  @@index([locationId])
  @@index([referenciaTipo, referenciaId])
  @@map("movimientos_inventario")
  @@schema("inventory")
}

// =====================================================================
// Manufacturing (Sprint 7) — órdenes de producción
// =====================================================================

enum EstadoOrdenProduccion {
  Planificada
  EnProceso
  Completada
  Cerrada
  Cancelada

  @@schema("manufacturing")
}

enum PrioridadProduccion {
  Alta
  Media
  Baja

  @@schema("manufacturing")
}

model OrdenProduccion {
  id                    String                 @id @db.Uuid
  tenantId              String                 @map("tenant_id") @db.Uuid
  codigo                String                 @db.VarChar(50)
  productoTerminadoId   String                 @map("producto_terminado_id") @db.Uuid
  productoTerminadoCode String                 @map("producto_terminado_code") @db.VarChar(50)
  productoTerminadoName String                 @map("producto_terminado_name") @db.VarChar(200)
  cantidadObjetivo      Decimal                @map("cantidad_objetivo") @db.Decimal(18, 6)
  estado                EstadoOrdenProduccion  @default(Planificada)
  prioridad             PrioridadProduccion    @default(Media)
  componentes           Json                   @default("[]")
  materialesReservados  Boolean                @default(false) @map("materiales_reservados")
  notas                 String?
  canceladoMotivo       String?                @map("cancelado_motivo")
  canceladoPor          String?                @map("cancelado_por") @db.Uuid
  canceladoEn           DateTime?              @map("cancelado_en") @db.Timestamptz
  fechaProgramada       DateTime?              @map("fecha_programada") @db.Timestamptz
  iniciadoEn            DateTime?              @map("iniciado_en") @db.Timestamptz
  completadoEn          DateTime?              @map("completado_en") @db.Timestamptz
  cerradoEn             DateTime?              @map("cerrado_en") @db.Timestamptz
  version               Int                    @default(1)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  consumos        ConsumoMp[]
  lotesProducidos LoteProducido[]

  @@unique([tenantId, codigo])
  @@index([tenantId])
  @@index([tenantId, estado])
  @@index([productoTerminadoId])
  @@index([fechaProgramada])
  @@map("ordenes_produccion")
  @@schema("manufacturing")
}

model ConsumoMp {
  id                 String   @id @db.Uuid
  ordenProduccionId  String   @map("orden_produccion_id") @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  productCode        String   @map("product_code") @db.VarChar(50)
  loteId             String   @map("lote_id") @db.Uuid
  codigoLote         String   @map("codigo_lote") @db.VarChar(50)
  cantidad           Decimal  @db.Decimal(18, 6)
  unidadMedida       String   @map("unidad_medida") @db.VarChar(10)
  movimientoId       String   @map("movimiento_id") @db.Uuid
  consumidoEn        DateTime @map("consumido_en") @db.Timestamptz

  ordenProduccion OrdenProduccion @relation(fields: [ordenProduccionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([ordenProduccionId])
  @@index([productId])
  @@index([loteId])
  @@map("consumos_mp")
  @@schema("manufacturing")
}

model LoteProducido {
  id                String   @id @db.Uuid
  ordenProduccionId String   @map("orden_produccion_id") @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  loteId            String   @map("lote_id") @db.Uuid
  codigoLote        String   @map("codigo_lote") @db.VarChar(50)
  productId         String   @map("product_id") @db.Uuid
  cantidad          Decimal  @db.Decimal(18, 6)
  locationId        String   @map("location_id") @db.Uuid
  movimientoId      String   @map("movimiento_id") @db.Uuid
  producidoEn       DateTime @map("producido_en") @db.Timestamptz

  ordenProduccion OrdenProduccion @relation(fields: [ordenProduccionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([ordenProduccionId])
  @@index([loteId])
  @@map("lotes_producidos")
  @@schema("manufacturing")
}

// =====================================================================
// Sales (Sprint 8) — Clientes y Órdenes de Venta
// =====================================================================

enum EstadoCliente {
  Activo
  Inactivo
  Suspendido

  @@schema("sales")
}

enum CondicionesPago {
  Contado
  Credito15
  Credito30
  Credito60
  Credito90

  @@schema("sales")
}

enum EstadoOrdenVenta {
  Borrador
  Confirmada
  Reservada
  Despachada
  Cerrada
  Cancelada

  @@schema("sales")
}

model Cliente {
  id               String          @id @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  codigo           String          @db.VarChar(50)
  nit              String          @db.VarChar(15)
  razonSocial      String          @map("razon_social") @db.VarChar(200)
  nombreComercial  String?         @map("nombre_comercial") @db.VarChar(200)
  estado           EstadoCliente   @default(Activo)
  condicionesPago  CondicionesPago @default(Contado) @map("condiciones_pago")
  direccionFiscal  Json            @map("direccion_fiscal")
  direccionEntrega Json?           @map("direccion_entrega")
  contactoNombre   String?         @map("contacto_nombre") @db.VarChar(200)
  contactoTelefono String?         @map("contacto_telefono") @db.VarChar(30)
  contactoEmail    String?         @map("contacto_email") @db.VarChar(320)
  notas            String?
  version          Int             @default(1)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  ordenes OrdenVenta[]

  @@unique([tenantId, codigo])
  @@unique([tenantId, nit])
  @@index([tenantId])
  @@index([tenantId, estado])
  @@index([razonSocial])
  @@map("clientes")
  @@schema("sales")
}

model OrdenVenta {
  id                 String           @id @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  codigo             String           @db.VarChar(50)
  clienteId          String           @map("cliente_id") @db.Uuid
  clienteCodigo      String           @map("cliente_codigo") @db.VarChar(50)
  clienteRazonSocial String           @map("cliente_razon_social") @db.VarChar(200)
  estado             EstadoOrdenVenta @default(Borrador)
  condicionesPago    CondicionesPago  @default(Contado) @map("condiciones_pago")
  direccionEntrega   Json             @map("direccion_entrega")
  subtotal           Decimal          @default(0) @db.Decimal(18, 2)
  ivaTotal           Decimal          @default(0) @map("iva_total") @db.Decimal(18, 2)
  total              Decimal          @default(0) @db.Decimal(18, 2)
  notas              String?
  canceladoMotivo    String?          @map("cancelado_motivo")
  canceladoPor       String?          @map("cancelado_por") @db.Uuid
  canceladoEn        DateTime?        @map("cancelado_en") @db.Timestamptz
  confirmadoEn       DateTime?        @map("confirmado_en") @db.Timestamptz
  reservadoEn        DateTime?        @map("reservado_en") @db.Timestamptz
  despachadoEn       DateTime?        @map("despachado_en") @db.Timestamptz
  cerradoEn          DateTime?        @map("cerrado_en") @db.Timestamptz
  version            Int              @default(1)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  cliente Cliente       @relation(fields: [clienteId], references: [id])
  lineas  LineaPedido[]

  @@unique([tenantId, codigo])
  @@index([tenantId])
  @@index([tenantId, estado])
  @@index([clienteId])
  @@index([createdAt])
  @@map("ordenes_venta")
  @@schema("sales")
}

model LineaPedido {
  id             String   @id @db.Uuid
  ordenVentaId   String   @map("orden_venta_id") @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  productCode    String   @map("product_code") @db.VarChar(50)
  productName    String   @map("product_name") @db.VarChar(200)
  cantidad       Decimal  @db.Decimal(18, 6)
  precioUnitario Decimal  @map("precio_unitario") @db.Decimal(18, 2)
  tasaIva        Decimal  @map("tasa_iva") @db.Decimal(5, 2)
  subtotal       Decimal  @db.Decimal(18, 2)
  iva            Decimal  @db.Decimal(18, 2)
  total          Decimal  @db.Decimal(18, 2)
  position       Int      @default(0)
  notas          String?

  ordenVenta OrdenVenta @relation(fields: [ordenVentaId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([ordenVentaId])
  @@index([productId])
  @@map("lineas_pedido")
  @@schema("sales")
}